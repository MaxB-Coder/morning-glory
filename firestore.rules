rules_version = '2';
// Morning Glory — rules-only security (no Cloud Functions, stays on free Spark).
// Paste into Firebase console → Firestore → Rules → Publish.
//
// Model: shared data lives under households/{hid}; private coffees live under
// users/{uid}. Only household members can touch household data; only the owner
// can touch their private data. Writes are also validated field by field, so a
// bad client or a hand-crafted request can't store junk that later breaks the
// app or gets rendered.

service cloud.firestore {
  match /databases/{db}/documents {

    function signedIn() { return request.auth != null; }
    function uid() { return request.auth.uid; }

    // members list of a household (safe: only called when doc exists)
    function memberUids(hid) {
      return get(/databases/$(db)/documents/households/$(hid)).data.memberUids;
    }
    function isMember(hid) {
      return signedIn() && uid() in memberUids(hid);
    }

    // ---- field validation --------------------------------------------------
    // Deliberately validates the shape of KNOWN fields but does not forbid
    // unknown ones: locking the key set would mean every future field addition
    // silently breaks syncing on older rules until they're republished.

    // Optional fields are checked with data.get(key, default): if absent, the
    // default satisfies the test. Written out longhand on purpose — a helper
    // taking a dynamic key would rely on map indexing by variable, which isn't
    // guaranteed in the rules language.

    // NOTE ON NULLS: the app writes explicit nulls for blank optional fields
    // (origin: value || null), so every optional check must accept null as
    // well as absent. Testing only `is string` would reject every real write.

    function validCoffee(d) {
      return d.name is string && d.name.size() > 0 && d.name.size() <= 120
        && d.roast in ['light', 'medium', 'dark']
        && d.process in ['washed', 'honey', 'natural']
        && d.get('visibility', 'shared') in ['shared', 'private']
        && d.updatedAt is number
        && (d.get('origin', null) == null
            || (d.get('origin', null) is string && d.get('origin', null).size() <= 80))
        && (d.get('variety', null) == null
            || (d.get('variety', null) is string && d.get('variety', null).size() <= 80))
        && (d.get('notes', null) == null
            || (d.get('notes', null) is string && d.get('notes', null).size() <= 2000))
        && (d.get('roastDate', null) == null
            || (d.get('roastDate', null) is string && d.get('roastDate', null).size() <= 30))
        && (d.get('createdAt', null) == null
            || (d.get('createdAt', null) is string && d.get('createdAt', null).size() <= 40))
        && (d.get('altitudeMasl', null) == null
            || (d.get('altitudeMasl', null) is number
                && d.get('altitudeMasl', null) >= 0
                && d.get('altitudeMasl', null) <= 4000))
        // photo must be a base64 image data URL, and must stay well clear of
        // the ~1 MB document ceiling or the whole coffee stops syncing
        && (d.get('photo', null) == null
            || (d.get('photo', null) is string
                && d.get('photo', null).size() <= 600000
                && d.get('photo', null).matches('data:image/(png|jpeg|jpg|webp);base64,[A-Za-z0-9+/=]+')));
    }

    function validBrew(d) {
      return d.coffeeId is string && d.coffeeId.size() > 0 && d.coffeeId.size() <= 64
        && d.method in ['espresso', 'moka', 'aeropress', 'v60', 'chemex',
                        'frenchpress', 'coldbrew']
        && d.grindSetting is number
        && d.verdict in ['good', 'under', 'over', 'gusher', 'choked']
        && d.updatedAt is number
        && (d.get('createdAt', null) == null
            || (d.get('createdAt', null) is string && d.get('createdAt', null).size() <= 40))
        && (d.get('doseG', null) == null
            || (d.get('doseG', null) is number
                && d.get('doseG', null) >= 0 && d.get('doseG', null) <= 500))
        && (d.get('yieldG', null) == null
            || (d.get('yieldG', null) is number
                && d.get('yieldG', null) >= 0 && d.get('yieldG', null) <= 5000))
        && (d.get('shotTimeS', null) == null
            || (d.get('shotTimeS', null) is number
                && d.get('shotTimeS', null) >= 0 && d.get('shotTimeS', null) <= 600))
        && (d.get('brewTimeS', null) == null
            || (d.get('brewTimeS', null) is number
                && d.get('brewTimeS', null) >= 0 && d.get('brewTimeS', null) <= 3600))
        && (d.get('waterTempC', null) == null
            || (d.get('waterTempC', null) is number
                && d.get('waterTempC', null) >= 0 && d.get('waterTempC', null) <= 110));
    }

    // A tombstone (deleted: true) still carries its normal fields, so the same
    // validators apply to deletes-by-flag as to ordinary writes.
    function validDoc(col, d) {
      return (col == 'coffees' && validCoffee(d))
          || (col == 'brews' && validBrew(d));
    }

    // ---- households ------------------------------------------------------
    match /households/{hid} {
      allow read: if isMember(hid);

      // create: you must be the sole initial member
      allow create: if signedIn()
        && request.resource.data.memberUids.hasOnly([uid()])
        && uid() in request.resource.data.memberUids;

      // update: either you're already a member, OR you are joining.
      //
      // A JOINER may only add their own uid to memberUids. Everything else
      // must be untouched — without these equality checks a stranger mid-join
      // could rename the household, rewrite the shared grinder, or replace the
      // invite code while adding themselves.
      allow update: if isMember(hid)
        || (signedIn()
            && request.resource.data.memberUids.hasAll(resource.data.memberUids)
            && request.resource.data.memberUids.hasOnly(resource.data.memberUids.concat([uid()]))
            && request.resource.data.inviteCode == resource.data.inviteCode
            && request.resource.data.name == resource.data.name
            && request.resource.data.get('grinder', null) == resource.data.get('grinder', null)
           );

      allow delete: if false;

      // shared coffees and brews — members only, and must be well formed.
      // Listing is fine here: you must be a member to see any of it.
      match /{col}/{docId} {
        allow read: if isMember(hid);
        allow create, update: if isMember(hid) && validDoc(col, request.resource.data);
        allow delete: if isMember(hid);
      }
    }

    // ---- invites (code -> householdId lookup) ----------------------------
    match /invites/{code} {
      // `get` only, NEVER `list`. A single `allow read` covers both, which let
      // any signed-in user enumerate the whole invites collection and harvest
      // every householdId. Splitting them means you must already know the
      // 6-character code to resolve it to a household.
      allow get: if signedIn();
      allow list: if false;

      allow create, update: if signedIn()
        && isMember(request.resource.data.householdId)
        && request.resource.data.householdId is string
        && request.resource.data.householdId.size() <= 64;
      allow delete: if isMember(resource.data.householdId);   // allow rotation
    }

    // ---- users -------------------------------------------------------------
    // The user doc itself (which household am I in), PLUS this user's private
    // coffees and brews. Nobody else — not even a household member — can read
    // these, which is what makes a "private" coffee actually private.
    match /users/{userId} {
      allow read, write: if signedIn() && uid() == userId;

      // private coffees / brews: owner only, same validation as shared ones
      match /{col}/{docId} {
        allow read: if signedIn() && uid() == userId;
        allow create, update: if signedIn() && uid() == userId
                              && validDoc(col, request.resource.data);
        allow delete: if signedIn() && uid() == userId;
      }
    }
  }
}
